  roomContents: "\uB3D9\uAD74 \uC548\uC744 \uAC77\uB358 \uC911 \uBC14\uC704 \uC704\uC5D0
    \uB193\uC778 \uC190\uAC70\uC6B8\uC744 \uBC1C\uACAC\uD569\uB2C8\uB2E4.\n\uB2F9\uC2E0\uC740
    \uADF8 \uAC70\uC6B8\uC744 \uC0B4\uD3B4\uBCF4\uB2E4, \uBE68\uB824\uB4E4\uC5B4\uAC08
    \uAC83 \uAC19\uC740 \uB290\uB08C\uC744 \uB290\uB08D\uB2C8\uB2E4."
  eventKeyword:
  - {fileID: 7579075665694996604, guid: e7bfe5c9db232824eab7d91bbcb7f35f, type: 3}
  - {fileID: 7579075665694996604, guid: c88820051c43416499075dc2a58a06b9, type: 3}
  - {fileID: 7579075665694996604, guid: 30b77db8122daa84ea876de2fe6699d3, type: 3}
  roomContentsAfter: "\uC190\uAC70\uC6B8\uC744 \uC790\uC138\uD788 \uB4E4\uC5EC\uB2E4
    \uBCF4\uC790, \uD798\uC774 \uBE60\uC838\uB098\uAC00\uB294 \uB290\uB08C\uC774
    \uB4E4\uC5C8\uB2E4."
  roomContentsAfter2: "\uB2F9\uC2E0\uC740 \uAC70\uC6B8\uC744 \uB545\uBC14\uB2E5\uC5D0
    \uB358\uC838\uBC84\uB9BD\uB2C8\uB2E4.\n\uC0AC\uBC29\uC73C\uB85C \uD769\uC5B4\uC9C4
    \uAC70\uC6B8 \uC870\uAC01 \uC911 \uD558\uB098\uB97C \uC90D\uC2B5\uB2C8\uB2E4."
  roomContentsAfter3: "\uB2F9\uC2E0\uC740 \uC190\uAC70\uC6B8\uC744 \uB4E4\uC5B4 \uAC00\uBC29\uC5D0
    \uB123\uC2B5\uB2C8\uB2E4.\n\uC660\uC9C0 \uC720\uC6A9\uD558\uAC8C \uC0AC\uC6A9\uB420
    \uAC83 \uAC19\uC2B5\uB2C8\uB2E4."
