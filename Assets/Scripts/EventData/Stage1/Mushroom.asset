  - {fileID: 7579075665694996604, guid: a82d73dfb86868b48a3b7cc4810caf19, type: 3}
  roomContentsAfter: "\"\uBE68\uAC04 \uBC84\uC12F\uC774 \uC2A4\uD504\uB9C1\uCC98\uB7FC
    \uD280\uC5B4\uC62C\uB790\uB2E4!\""
  roomContentsAfter2: "\"\uD30C\uB780 \uBC84\uC12F\uC744 \uBA39\uC790, \uD53C\uB85C\uAC00
    \uC0AC\uB77C\uC9C0\uB294 \uB290\uB08C\uC774 \uB4E0\uB2E4.\""
  roomContentsAfter3: "\"\uB178\uB780 \uBC84\uC12F\uC744 \uBA39\uC790, \uC9D1\uC911\uB825\uC774
    \uC62C\uB77C\uAC04 \uB290\uB08C\uC774 \uB4E0\uB2E4.\""
