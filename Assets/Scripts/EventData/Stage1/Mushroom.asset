  roomContents: "\uC232\uC744 \uC9C0\uB098\uB358 \uC911 \uB2F9\uC2E0\uC740 \uBC84\uC12F
    \uBB34\uB354\uAE30\uB97C \uBC1C\uACAC\uD558\uC600\uC2B5\uB2C8\uB2E4.\n\uB9C8\uCE68
    \uBC30\uAC00 \uACE0\uD320\uB358 \uB2F9\uC2E0\uC740 \uBC84\uC12F\uC5D0 \uAC00\uAE4C\uC774
    \uB2E4\uAC00\uAC11\uB2C8\uB2E4.\n\uBE68\uAC04 \uBC84\uC12F, \uD30C\uB780\uBC84\uC12F,
    \uB178\uB780\uBC84\uC12F\uC774 \uC788\uC2B5\uB2C8\uB2E4.\n\uB2F9\uC2E0\uC740
    \uC5B4\uB5A4 \uBC84\uC12F\uC744 \uBA39\uC744\uC9C0 \uACE0\uBBFC\uD569\uB2C8\uB2E4."
  eventKeyword:
  - {fileID: 7579075665694996604, guid: 8c936ee77e360a1428b7cf463d1d4eca, type: 3}
