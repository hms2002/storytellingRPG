  roomContentsAfter: "\uADF8\uB0E5 \uC9C0\uB098\uCE58\uC790 \uD140\uBE14\uBC84\uB4DC\uB294
    \uC12D\uC12D\uD574 \uD569\uB2C8\uB2E4."
  roomContentsAfter2: "\uAE30\uBED0\uD558\uB294 \uD140\uBE14\uBC84\uB4DC\uB97C \uBCF4\uB2C8
    \uAE30\uBD84\uC774 \uC88B\uC544\uC9C4\uB2E4."
  roomContentsAfter3: "\uAE68\uB057\uD574\uC9C4 \uD140\uBE14\uBC84\uB4DC\uAC00 \uACE0\uB9C8\uC6CC
