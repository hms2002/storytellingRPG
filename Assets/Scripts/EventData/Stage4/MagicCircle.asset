  roomContents: "\uB2F9\uC2E0\uC740 \uD0D1\uC744 \uD0D0\uC0C9\uD558\uB358 \uC911
    \uB9C8\uBC95\uC9C4\uC744 \uBC1C\uACAC\uD569\uB2C8\uB2E4.\n\uB9C8\uBC95\uC9C4
    \uC55E\uC5D0\uB294 \uCC45\uC774 \uB193\uC5EC\uC838 \uC788\uC2B5\uB2C8\uB2E4.\n\uCC45\uC744
    \uB4E4\uC5B4 \uB0B4\uC6A9\uC744 \uD655\uC778\uD574 \uBCF4\uB2C8, \uC8FC\uBB38\uC11C\uB97C
    \uC0DD\uC131\uD558\uB294 \uC8FC\uBB38\uC774 \uC368\uC838 \uC788\uC2B5\uB2C8\uB2E4.\n\uB2F9\uC2E0\uC740
    \uC8FC\uBB38 \uC911 \uD55C \uAC00\uC9C0\uB97C \uC601\uCC3D \uD558\uAE30\uB85C
    \uD569\uB2C8\uB2E4."
